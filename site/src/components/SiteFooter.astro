---
import { line, swoosh } from '../lib/ink';
---
<footer class="credits page">
  <svg class="credits__rule draw" viewBox="0 0 600 14" aria-hidden="true" focusable="false">
    <path class="ink" d={line(2, 7, 596, 8, 41, 2)} pathLength="1" />
  </svg>
  <p class="credits__signoff">You made it to the <span class="credits__end">end credits<svg class="credits__swoosh" viewBox="0 0 200 16" preserveAspectRatio="none" aria-hidden="true" focusable="false"><path class="ink ink--accent" d={swoosh(4, 9, 192, 17, 3)} pathLength="1" /></svg></span>. Thanks for reading.</p>
  <div class="credits__cols">
    <nav aria-label="Footer">
      <ul role="list">
        <li><a href="/"><span class="link-text">About</span></a></li>
        <li><a href="/work/"><span class="link-text">Work</span></a></li>
        <li><a href="/contact/"><span class="link-text">Contact</span></a></li>
        <li><a href="/side-projects/"><span class="link-text">Side projects</span></a></li>
      </ul>
    </nav>
    <ul class="credits__contact" role="list">
      <li>
        <a class="js-email" href="/contact/" data-u="autumn" data-d="hey.com">
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path class="ink" d="M3.2 6.4c5.8-.5 11.7-.4 17.6 0 .3 3.8.3 7.6 0 11.3-5.9.4-11.7.4-17.5 0-.4-3.7-.4-7.5-.1-11.3zM3.6 6.9c2.7 2.4 5.5 4.6 8.4 6.5 3-1.9 5.8-4.1 8.5-6.6" /></svg>
          <span class="link-text">Email</span>
        </a>
      </li>
      <li>
        <a href="https://www.linkedin.com/in/autumn-willard">
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path class="ink" d="M3.4 3.6c5.7-.4 11.4-.3 17.2 0 .3 5.6.3 11.2 0 16.8-5.8.3-11.5.3-17.2 0-.3-5.6-.3-11.2 0-16.8zM7.6 10.4v6.4M7.6 7.3v.2M11.2 16.8c0-2.2-.1-4.3 0-6.4M11.3 12.6c.6-1.6 1.7-2.3 3-2.2 1.4.2 2 1.2 2 3v3.4" /></svg>
          <span class="link-text">LinkedIn</span>
        </a>
      </li>
      <li>
        <a href="/autumn-willard-resume.pdf">
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path class="ink" d="M5.4 2.8c3.3-.2 6.6-.2 9.8 0l3.6 3.7c.2 4.8.2 9.7 0 14.6-4.5.3-8.9.3-13.4 0-.3-6.1-.3-12.2 0-18.3zM15 3c-.1 1.3 0 2.6.1 3.8 1.2.1 2.4.1 3.6 0M8.3 11.2h7.3M8.3 14.4h7.4M8.4 17.5h4.6" /></svg>
          <span class="link-text">Résumé (PDF)</span>
        </a>
      </li>
      <li>
        <a href="https://github.com/autumnwillard">
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path class="ink" d="M8.2 20.4c-3.6 1-3.7-1.8-5.1-2.2M15.6 21v-3c.1-1 0-2-.8-2.6 2.6-.3 5.3-1.3 5.3-5.7 0-1.2-.4-2.3-1.2-3.1.3-1.1.3-2.3-.2-3.3 0 0-1-.3-3.2 1.2-1.9-.5-3.8-.5-5.6 0C7.7 3 6.7 3.3 6.7 3.3c-.5 1-.5 2.2-.1 3.3-.8.9-1.3 2-1.2 3.1 0 4.4 2.6 5.4 5.3 5.7-.6.5-.9 1.3-.8 2.1V21" /></svg>
          <span class="link-text">GitHub</span>
        </a>
      </li>
    </ul>
  </div>
  <p class="credits__small">© 2026 Autumn Willard</p>
</footer>

<style>
  .credits { padding-top: var(--s4); padding-bottom: var(--s4); }
  .credits__rule { width: min(100%, 36rem); height: 14px; overflow: visible; margin-bottom: var(--s2); }
  .credits__rule .ink { stroke-width: 2; }
  .credits__signoff { font-family: var(--font-hand); font-size: var(--step-2); line-height: 1.15; margin-bottom: var(--s2); }
  /* A coral swoosh under "end credits", drawn as the sign-off is written in (global.css). */
  .credits__end { position: relative; white-space: nowrap; }
  .credits__swoosh { position: absolute; left: -0.1em; right: -0.1em; bottom: -0.32em; width: calc(100% + 0.2em); height: 0.42em; overflow: visible; pointer-events: none; }
  .credits__swoosh .ink { stroke-width: 3; }
  @media (prefers-reduced-motion: no-preference) {
    .credits__swoosh .ink { stroke-dasharray: 1 1; stroke-dashoffset: 0; transition: stroke-dashoffset 750ms var(--ease-pen) 420ms; }
    .credits__signoff.is-waiting .credits__swoosh .ink { stroke-dashoffset: 1; transition: none; }
  }
  .credits__cols { display: flex; flex-wrap: wrap; gap: var(--s2) var(--s4); }
  .credits ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.4rem 1.4rem; }
  .credits a { font-weight: 700; display: inline-flex; align-items: center; gap: 0.4rem; min-height: 44px; }
  .credits__contact svg { width: 1.35rem; height: 1.35rem; flex: none; }
  .credits__contact .ink { stroke-width: 1.7; }
  .credits__small { color: var(--ink-soft); font-size: var(--step--1); margin-top: var(--s2); }
</style>
