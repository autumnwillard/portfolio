---
// An aside. Two kinds, picked per aside by length and tone:
//   kind="sticky" (default): a square sticky note, slightly rotated, hand-lettered.
//                  For short, punchy asides and jokes.
//   kind="card":   a lined index card in the body font. For longer asides or explanations.
// The tilt is static (no animation), so it stays under reduced motion.
interface Props {
  kind?: 'sticky' | 'card';
  color?: 'yellow' | 'rose' | 'sage' | 'blue';
  size?: 'sm' | 'md'; // sticky only: sm for one-liners
  tilt?: number;      // degrees
  class?: string;
  float?: boolean;    // float into the right margin on wide case-study pages
}
const { kind = 'sticky', color = 'yellow', size = 'md', tilt = kind === 'card' ? -0.8 : -2, class: cls = '', float = false } = Astro.props;
---
<aside
  class:list={['note', `note--${kind}`, kind === 'sticky' && ['sticky', `sticky--${color}`, `note--${size}`], kind === 'card' && 'index-card', float && 'note--float', cls]}
  style={`--tilt:${tilt}deg`}
  aria-label="Aside"
>
  <div class="note__text"><slot /></div>
</aside>

<style>
  .note {
    position: relative;
    margin: var(--s3) 0;
    transform: rotate(var(--tilt));
  }
  .note__text :global(p) { margin: 0; }
  .note__text :global(p + p) { margin-top: 0.6rem; }
  .note__text :global(a) { font-weight: 700; }

  /* ---------- Square sticky note ---------- */
  .note--sticky {
    width: min(100%, var(--note-size, 16rem));
    aspect-ratio: 1;               /* grows taller only if the text needs it */
    display: flex;
    align-items: center;
    padding: 1.7rem 1.25rem 1.3rem;
  }
  .note--sticky .note__text {
    font-family: var(--font-hand);
    font-size: 1.42rem;
    line-height: 1.22;
    color: var(--ink);
    text-wrap: pretty;
  }
  .note--sm { --note-size: 12.5rem; }
  .note--sticky .note__text :global(a) { font-family: var(--font-body); font-size: 1rem; white-space: nowrap; }

  /* ---------- Lined index card ---------- */
  .note--card {
    --card-head: 1.35rem;
    max-width: 32rem;
    padding: 1.8rem 1.4rem 1.25rem;
  }
  .note--card .note__text { font-size: 1.04rem; line-height: var(--card-pitch); font-weight: 600; }

  @media (min-width: 1180px) {
    .note--float {
      float: right;
      clear: right;
      width: 16rem;
      margin: 0.3rem calc(-1 * (16rem + var(--s3))) var(--s2) var(--s3);
    }
  }
  @media (max-width: 520px) {
    .note { transform: rotate(calc(var(--tilt) * 0.6)); }
    .note--md { --note-size: 15rem; }
    .note--sticky { padding: 1.5rem 1.1rem 1.1rem; }
    .note--sticky .note__text { font-size: 1.3rem; }
    .note--card { padding-inline: 1.1rem; }
  }
</style>
