---
// An index flag (a Post-it page flag): a coloured flag with a translucent film strip on
// its left end, the part that sticks. Primary is coral, secondary is blue.
// On hover/focus the free right end lifts off the page as if you're about to turn a page
// with it; on press it snaps back flat. Reduced motion: a static lifted shadow only.
// Renders <a> when href is given, otherwise <button>. Extra attributes pass through.
interface Props {
  href?: string;
  variant?: 'primary' | 'secondary';
  size?: 'md' | 'sm';
  type?: 'button' | 'submit';
  class?: string;
  [key: string]: unknown;
}
const { href, variant = 'secondary', size = 'md', type = 'button', class: cls = '', ...rest } = Astro.props;
const label = await Astro.slots.render('default');

// A stable, slightly different tilt per label so a row of flags isn't uniform.
let seed = 7;
for (const ch of label) seed = (seed * 31 + ch.charCodeAt(0)) % 9973;
const tilt = (((seed % 7) - 3) * 0.35).toFixed(2);
const Tag = href ? 'a' : 'button';
---
<Tag
  class:list={['btn', `btn--${variant}`, size === 'sm' && 'btn--sm', cls]}
  href={href}
  type={href ? undefined : type}
  style={`--flag-tilt:${tilt}deg`}
  {...rest}
>
  <span class="btn__label btn__text"><Fragment set:html={label} /></span>
</Tag>
