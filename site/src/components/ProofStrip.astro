---
// "The short version": four headline numbers on same-size square sticky notes in a loose
// staggered row. Each note holds only the number and a short handwritten label. Variety
// comes from rotation and from how each note's bottom edge lifts off the page (its own
// shadow); the green one has a folded corner. Sticky notes stick on their own: no tape, no pins.
// The whole note is the link; its accessible name says which case study it opens.
import { arrow } from '../lib/ink';

const proof = [
  { num: '~85%', label: 'fewer severe defects', href: '/work/release-risk-review/', case: 'Release risk review', color: 'yellow', tilt: -2.4, lift: 0.45, bias: 0, kind: 'plain', dy: '0.4rem' },
  { num: '~70–80%', label: 'fewer manual reviews (projected)', href: '/work/ai-review-routing/', case: 'AI review routing', color: 'pink', tilt: 1.7, lift: 1.25, bias: -1, kind: 'plain', dy: '2.1rem' },
  { num: '10 workflows · 7 dashboards', small: true, label: 'used daily by four teams', href: '/work/ai-toolkit/', case: 'AI toolkit', color: 'blue', tilt: -1, lift: 1, bias: 0, kind: 'plain', dy: '0rem' },
  { num: 'Hundreds → nearly zero', small: true, label: 'abandoned records a year', href: '/work/lab-review-system/', case: 'Lab review system', color: 'green', tilt: 2.6, lift: 1.15, bias: 1, kind: 'peel', dy: '1.6rem' },
];
interface Props { seeAll?: boolean }
const { seeAll = false } = Astro.props;
const go = (seed: number) => { const a = arrow([[3, 10], [18, 5], [32, 11], [46, 7]], seed, 7); return `${a.shaft} ${a.head}`; };
---
<h2 id="proof-h" class="proof__h">The short version</h2>
<ul class="cascade" role="list">
  {proof.map((p, i) => (
    <li
      class:list={['jot', 'sticky', `sticky--${p.color}`, `jot--${p.kind}`]}
      style={`--tilt:${p.tilt}deg; --lift-at-rest:${p.lift}; --bias:${p.bias}; --dy:${p.dy}`}
    >
      {p.kind === 'peel' && <span class="jot__peel" aria-hidden="true"></span>}
      <a class="scrap__link jot__link" href={p.href}>
        <span class:list={['jot__num', p.small && 'jot__num--small']}>{p.num}</span>
        <span class="jot__label">{p.label}</span>
        <span class="visually-hidden">. Read the case study: {p.case}</span>
      </a>
      <svg class="jot__go" viewBox="0 0 50 16" aria-hidden="true" focusable="false"><path class="ink ink--accent" d={go(940 + i)} /></svg>
    </li>
  ))}
</ul>
{seeAll && <p class="cascade__all"><a class="text-link" href="/work/">See all the work →</a></p>}

<style>
  .proof__h { font-size: var(--step-1); color: var(--ink-soft); margin-bottom: var(--s2); }

  /* Four same-size squares spread across the full width, each nudged up or down. */
  .cascade {
    --size: 13.5rem;
    list-style: none;
    margin: 0;
    padding: 1.25rem 0.75rem 2rem;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    justify-items: center;
    align-items: start;
    gap: 2rem 1.5rem;
  }
  .jot {
    width: min(100%, var(--size));
    aspect-ratio: 1;
    margin-top: var(--dy);
    padding: 1.4rem 1rem 1.2rem;
    display: grid;
    place-items: center;
    text-align: center;
    transform: rotate(var(--tilt));
    cursor: pointer;
  }
  .jot:hover, .jot:focus-within { z-index: 5; }

  .jot__link { display: flex; flex-direction: column; align-items: center; gap: 0.35rem; color: var(--ink); text-decoration: none; }
  .jot__link::after { content: ''; position: absolute; inset: 0; z-index: 1; }
  .jot__link:focus-visible { outline: none; }
  .jot:has(.jot__link:focus-visible) { outline: 2.5px dashed var(--accent-ink); outline-offset: 6px; }
  .jot__num { white-space: nowrap; font-family: var(--font-hand); font-size: clamp(2.3rem, 3.3vw, 3.1rem); line-height: 0.95; color: var(--accent-deep); }
  .jot__num--small { white-space: normal; font-size: clamp(1.5rem, 2vw, 1.85rem); line-height: 1.02; text-wrap: balance; }
  .jot__label { font-family: var(--font-hand); font-size: clamp(1.15rem, 1.5vw, 1.35rem); line-height: 1.12; color: var(--ink); text-wrap: balance; }

  /* a small coral arrow that turns up on hover, like a scribbled "→ this way" */
  .jot__go { position: absolute; left: 50%; bottom: 0.55rem; width: 2.6rem; translate: -50% 0; overflow: visible; opacity: 0; pointer-events: none; }
  .jot__go .ink { stroke-width: 2.2; }
  .jot:hover .jot__go, .jot:focus-within .jot__go { opacity: 1; }
  @media (prefers-reduced-motion: no-preference) {
    .jot__go { transition: opacity 200ms ease, translate 200ms ease; }
    .jot:hover .jot__go, .jot:focus-within .jot__go { translate: calc(-50% + 4px) 0; }
  }

  /* peel: the bottom-right corner folds back toward the viewer. The face is clipped, so
     the lifted-edge shadows come from drop-shadow filters that follow the clipped shape. */
  .jot--peel::before {
    clip-path: polygon(0 0, 100% 0, 100% calc(100% - 3rem), calc(100% - 3rem) 100%, 0 100%);
    box-shadow: none;
  }
  .jot--peel {
    filter:
      drop-shadow(0 0.5px 0.6px rgb(60 45 25 / 0.25))
      drop-shadow(calc(var(--lift) * 3px) calc(var(--lift) * 5px) calc(var(--lift) * 4px) rgb(60 45 25 / 0.2));
  }
  .jot__peel {
    position: absolute; right: 0; bottom: 0; width: 3rem; height: 3rem; z-index: 0;
    background: linear-gradient(135deg, rgb(255 255 255 / 0.65), rgb(255 255 255 / 0.2) 65%), var(--sticky);
    clip-path: polygon(0 0, 100% 0, 0 100%);
    pointer-events: none;
  }
  /* a small shadow cast by the fold onto the note */
  .jot__peel::before {
    content: ''; position: absolute; inset: 0;
    background: linear-gradient(135deg, transparent 40%, rgb(60 45 25 / 0.18) 50%, transparent 58%);
  }

  .cascade__all { margin-top: var(--s1); }

  /* Narrow tablets: two by two */
  @media (max-width: 900px) and (min-width: 641px) {
    .cascade { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  /* Phones: one column, alternating left and right with a light overlap */
  @media (max-width: 640px) {
    .cascade { --size: 12.5rem; display: flex; flex-direction: column; flex-wrap: nowrap; align-items: flex-start; gap: 0; padding: 1.25rem 1.25rem 2rem 0.25rem; }
    .jot { width: var(--size); }
    .jot, .jot + .jot { margin: -0.4rem 0 0; }
    .jot:first-child { margin-top: 0; }
    .jot + .jot:nth-child(even) { margin-left: auto; margin-right: 0.25rem; }
    .jot + .jot:nth-child(3) { margin-left: 0.75rem; }
    .jot__num:not(.jot__num--small) { font-size: 2.7rem; }
    .jot__num--small { font-size: 1.85rem; }
    .jot__label { font-size: 1.35rem; }
  }
</style>
