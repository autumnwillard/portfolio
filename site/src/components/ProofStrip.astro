---
// "The short version": four headline numbers on square sticky notes in a loose cluster.
// Each note keeps only the big number, a short label, its status chip(s) and a "see how"
// cue; the explanatory captions sit in a small footnote list beside the cluster.
// Each whole note links to its case study: the link wraps the number and label (its
// accessible name, plus the case name) and stretches over the note.
import { arrow } from '../lib/ink';
import Highlight from './Highlight.astro';
import StatusBadge from './StatusBadge.astro';

const proof = [
  { num: '~85%', hl: true, label: 'fewer severe defects', chips: ['In use'], caption: 'Severe = breaks core function, triggers a SEV call. Dec 2025 to ~Sept 2026.', href: '/work/release-risk-review/', case: 'Release risk review', color: 'yellow', tilt: -2.4, dx: '0rem', dy: '0rem' },
  { num: '~70–80%', label: 'fewer manual reviews (projected)', chips: ['Projected (estimate)', 'Approved · in build when I left'], caption: 'Estimated from reviewer comments flagging wrong screening answers.', href: '/work/ai-review-routing/', case: 'AI review routing', color: 'pink', tilt: 1.8, dx: '-0.6rem', dy: '1.4rem' },
  { num: '10 workflows · 7 dashboards', small: true, label: 'used daily by four engineering teams', chips: ['In daily use'], caption: 'An internal product I built for my own teams.', href: '/work/ai-toolkit/', case: 'AI toolkit', color: 'blue', tilt: 1.2, dx: '0.8rem', dy: '-0.4rem' },
  { num: 'Hundreds per year → nearly zero', small: true, label: 'abandoned records', chips: ['Shipped'], caption: 'Three small UI changes, not a redesign.', href: '/work/lab-review-system/', case: 'Lab review system', color: 'green', tilt: -1.6, dx: '0rem', dy: '0.9rem' },
];
const cue = (seed: number) => { const a = arrow([[3, 9], [16, 5], [30, 10], [44, 7]], seed, 7); return `${a.shaft} ${a.head}`; };
---
<h2 id="proof-h" class="proof__h">The short version</h2>
<div class="proof">
  <ul class="proof__cluster" role="list">
    {proof.map((p, i) => (
      <li class={`scrap sticky sticky--${p.color}`} style={`--tilt:${p.tilt}deg; --dx:${p.dx}; --dy:${p.dy}`}>
        <a class="scrap__link" href={p.href}>
          <span class:list={['scrap__num', p.small && 'scrap__num--small']}>
            {p.hl ? <Highlight>{p.num}</Highlight> : p.num}
          </span>
          <span class="scrap__label">{p.label}</span>
          <span class="visually-hidden">. Case study: {p.case}</span>
        </a>
        <p class="scrap__chips">{p.chips.map((c) => <StatusBadge status={c} size="sm" />)}</p>
        <p class="scrap__cue" aria-hidden="true">see how <svg viewBox="0 0 48 16" focusable="false"><path class="ink ink--accent" d={cue(900 + i)} /></svg></p>
      </li>
    ))}
  </ul>
  <ul class="proof__notes" role="list">
    {proof.map((p) => <li><strong>{p.num}</strong> {p.caption}</li>)}
  </ul>
</div>

<style>
  .proof__h { font-size: var(--step-1); color: var(--ink-soft); margin-bottom: var(--s2); }
  .proof { display: grid; grid-template-columns: auto minmax(0, 22rem); gap: var(--s3) var(--s4); align-items: center; }

  /* A loose 2×2 cluster: square notes, nudged and turned a little differently */
  .proof__cluster {
    list-style: none;
    margin: 0;
    padding: 0.5rem 0 1.5rem;
    display: grid;
    grid-template-columns: repeat(2, var(--note, 16.5rem));
    gap: 1rem 0.9rem;
  }
  .scrap {
    position: relative;
    top: var(--dy);
    left: var(--dx);
    aspect-ratio: 1;            /* square; grows only if text ever needs it */
    padding: 1.75rem 1.1rem 1rem;
    transform: rotate(var(--tilt));
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    cursor: pointer;
  }
  .scrap p { margin: 0; }
  .scrap__link { display: flex; flex-direction: column; gap: 0.3rem; color: var(--ink); text-decoration: none; }
  .scrap__link::after { content: ''; position: absolute; inset: 0; z-index: 1; }
  .scrap__link:focus-visible { outline: none; }
  .scrap:has(.scrap__link:focus-visible) { outline: 2.5px dashed var(--accent-ink); outline-offset: 6px; }
  .scrap__num, .scrap__label { display: block; }
  .scrap__num { font-family: var(--font-hand); font-size: 3rem; line-height: 1; color: var(--accent-deep); }
  .scrap__num :global(mark) { color: var(--accent-deep); }
  .scrap__num--small { font-size: 1.75rem; line-height: 1.08; }
  .scrap__label { font-weight: 800; font-size: 0.98rem; line-height: 1.3; }
  .scrap__chips { display: flex; flex-wrap: wrap; gap: 0.3rem; }
  .scrap :global(.stamp) { background: rgb(255 255 255 / 0.55); }
  .scrap__cue { display: flex; align-items: center; gap: 0.3rem; margin-top: auto !important; font-family: var(--font-hand); font-size: 1.2rem; line-height: 1; color: var(--ink); }
  .scrap__cue svg { width: 2.6rem; height: auto; overflow: visible; }
  .scrap__cue .ink { stroke-width: 2; }
  @media (prefers-reduced-motion: no-preference) {
    .scrap__cue svg { transition: transform 200ms ease; }
    .scrap:hover .scrap__cue svg, .scrap:focus-within .scrap__cue svg { transform: translateX(3px); }
  }

  /* The small print, kept out of the notes */
  .proof__notes { list-style: none; margin: 0; padding: 0 0 0 1rem; border-left: 2px solid var(--rule); font-size: var(--step--1); line-height: 1.5; color: var(--ink-soft); }
  .proof__notes li + li { margin-top: 0.6rem; }
  .proof__notes strong { color: var(--ink); font-weight: 800; }

  @media (max-width: 1000px) {
    .proof { grid-template-columns: minmax(0, 1fr); }
  }
  /* Phones: one column, alternating turns and a little side-to-side drift */
  @media (max-width: 600px) {
    .proof__cluster { grid-template-columns: minmax(0, 1fr); gap: 1.6rem; padding-right: 1.25rem; }
    .scrap { top: 0; left: 0; width: min(100%, 17rem); }
    .scrap:nth-child(even) { margin-left: auto; }
    .scrap:nth-child(odd) { margin-left: 0.4rem; }
    .scrap { width: min(100%, 16rem); }
    .scrap__num:not(.scrap__num--small) { font-size: 2.6rem; }
  }
</style>
