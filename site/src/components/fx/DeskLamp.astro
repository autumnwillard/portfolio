---
// Desk lamp: a WebGL layer under the About hero. The page's paper gets real fibers,
// and a warm pool of lamp light follows the mouse. Raking light picks out the fiber
// relief only near the lamp, the way real paper looks under a desk lamp.
// The lamp "clicks on" with a small flicker the first time the hero shows.
// Phones: a tap moves the lamp. Reduced motion, no WebGL or no JS: nothing renders
// and the hero looks exactly as it always did. Colors come from the design tokens.
---
<canvas class="lamp" data-desk-lamp aria-hidden="true"></canvas>

<script>
  import { initDeskLamp } from '../../scripts/fx-about-lamp';
  let stop: (() => void) | null = null;
  document.addEventListener('astro:page-load', () => {
    stop?.();
    const el = document.querySelector<HTMLCanvasElement>('[data-desk-lamp]');
    stop = el ? initDeskLamp(el) : null;
  });
  document.addEventListener('astro:before-swap', () => {
    stop?.();
    stop = null;
  });
</script>

<style>
  .lamp {
    position: absolute;
    z-index: 0;
    top: -1.5rem;
    left: -4rem;
    width: calc(100% + 8rem);
    height: calc(100% + 4.5rem);
    pointer-events: none;
    opacity: 0;
    transition: opacity 400ms ease;
  }
  .lamp.is-on { opacity: 1; }
  @media (max-width: 760px) {
    .lamp { top: -1rem; left: -2rem; width: calc(100% + 4rem); height: calc(100% + 3rem); }
  }
  @media (prefers-reduced-motion: reduce) {
    .lamp { display: none; }
  }
</style>
