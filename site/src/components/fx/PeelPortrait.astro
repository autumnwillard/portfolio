---
// Wraps the taped-in hero portrait so its loose bottom corners can be grabbed and
// peeled up off the page. It behaves like a photo print (stiff, glossy card): the corner
// rolls up in one smooth curl with a plain off-white back, a shine along the roll and a
// shadow that's sharp where it leaves the page. Let go and it snaps back down.
// Only on purpose: grab a bottom corner (grab cursor) and drag. Plain hover never moves the
// corner, and nothing peels by itself.
// Without JS (or with reduced motion and no drag) it is just the taped photo.
---
<div class="peel" data-peel>
  <slot />
</div>

<script>
  import { initPeel } from '../../scripts/fx-about-peel';
  let stop: (() => void) | null = null;
  document.addEventListener('astro:page-load', () => {
    stop?.();
    const el = document.querySelector<HTMLElement>('[data-peel]');
    stop = el ? initPeel(el) : null;
  });
  document.addEventListener('astro:before-swap', () => {
    stop?.();
    stop = null;
  });
</script>

<style>
  .peel { position: relative; }
  /* Hover lifts the print like every taped photo. While a corner is curled up the print is
     flat on the page except for that corner, so the lift waits. */
  .peel.is-peeling :global(.taped__photo) { transform: none !important; }
  .peel.is-peeling :global(.taped__drift)::before { transform: none !important; }
  /* the lifted corner: SVG drawn in the print's own pixel box (fx-about-peel.ts) */
  .peel :global(.peel-flap) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
    overflow: visible;
    pointer-events: none;
    visibility: hidden;
  }
  .peel :global(.peel-shade-soft) { fill: rgb(var(--shadow, 60 50 40) / 0.3); }
  .peel :global(.peel-shade-tight) { fill: rgb(var(--shadow, 60 50 40) / 0.42); }
  /* looking into the curl: the photo's own side, in the roll's shadow */
  .peel :global(.peel-mouth) { fill: color-mix(in srgb, rgb(var(--shadow, 60 50 40)) 38%, var(--card, #fff)); }
  .peel :global(.peel-under) {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    font-family: var(--font-hand);
    color: var(--accent-ink);
    font-size: clamp(1.1rem, 2.2vw, 1.6rem);
    line-height: 1.1;
  }
  .peel :global(.peel-under span) { position: absolute; bottom: 7%; transform: rotate(-8deg); white-space: nowrap; }
  .peel :global(.peel-under .r) { right: 7%; }
  .peel :global(.peel-under .l) { left: 7%; transform: rotate(7deg); }
  .peel :global(.peel-grip) {
    position: absolute;
    z-index: 3;
    bottom: -14px;
    width: clamp(64px, 26%, 110px);
    aspect-ratio: 1;
    touch-action: none;
    cursor: grab;
  }
  /* touch: a smaller corner, so a scroll that happens to start on the photo still scrolls */
  @media (pointer: coarse) { .peel :global(.peel-grip) { width: 52px; bottom: -10px; } }
  .peel :global(.peel-grip.r) { right: -14px; }
  .peel :global(.peel-grip.l) { left: -14px; }
  .peel.is-dragging, .peel.is-dragging :global(.peel-grip) { cursor: grabbing; }
  .peel.is-dragging { user-select: none; -webkit-user-select: none; }
</style>
