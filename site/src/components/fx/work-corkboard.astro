---
// Overdrive (Work page): the Quick highlights become a corkboard. On arrival the notes are
// slapped onto the board one at a time (the board thumps, the notes already up there
// wobble). Then you can grab one and fling it: it flies, bounces off the edges of the
// board, knocks into the others, and springs back to where it was stuck.
// Mouse/pen: drag in any direction. Touch: swipe a note sideways (vertical swipes still
// scroll the page). A tap or click still opens the case study.
// Without JS, or with reduced motion, the notes are simply there (ProofStrip as is).
---
<div class="fx-cork" data-fx-cork>
  <p class="fx-cork__hint" aria-hidden="true">
    <span class="fx-cork__hint-fine">Go ahead, fling one.</span>
    <span class="fx-cork__hint-touch">Swipe one sideways.</span>
    <svg viewBox="0 0 40 30" focusable="false"><path d="M4 4c3 9 10 15 22 17M20 15c3 3 5 4.5 7 6-3 .6-6 1.6-8 3" /></svg>
  </p>
  <slot />
</div>

<script>
  import '../../scripts/fx-work-corkboard.ts';
</script>

<style>
  .fx-cork { position: relative; }

  /* Before the slap-in runs, the notes wait off the board. A failsafe shows them anyway
     if the script never arrives. Motion only; otherwise nothing is hidden. */
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .fx-cork:not(.is-live) :global(.jot) { opacity: 0; animation: fx-cork-failsafe 0s linear 2.5s forwards; }
  }
  @keyframes fx-cork-failsafe { to { opacity: 1; } }

  .fx-cork.is-live :global(.jot) { touch-action: pan-y; cursor: grab; user-select: none; -webkit-user-select: none; -webkit-touch-callout: none; }
  .fx-cork.is-live :global(.jot.is-held) { cursor: grabbing; z-index: 30; --lift: calc(var(--lift-at-rest, 1) + 1.6); }
  .fx-cork.is-live :global(.jot.is-held)::after,
  .fx-cork.is-live :global(.jot.is-flying)::after { opacity: 1; }
  .fx-cork.is-live :global(.jot.is-flying) { z-index: 25; }
  .fx-cork.is-live :global(.jot__link) { -webkit-user-drag: none; }

  /* Comic impact lines when a note hits the board */
  .fx-cork :global(.fx-slap) {
    position: absolute;
    inset: -14% -9%;
    width: 118%;
    height: 128%;
    overflow: visible;
    pointer-events: none;
    z-index: 3;
  }
  .fx-cork :global(.fx-slap path) { fill: none; stroke: var(--accent); stroke-width: 2.6; stroke-linecap: round; vector-effect: non-scaling-stroke; }

  /* The hint: handwritten, top right, written in once the last note has landed */
  .fx-cork__hint {
    display: none;
    position: absolute;
    top: 0.35rem;
    right: 0.5rem;
    margin: 0;
    font-family: var(--font-hand);
    font-size: 1.35rem;
    line-height: 1;
    color: var(--accent-ink);
    transform: rotate(-3deg);
    pointer-events: none;
  }
  .fx-cork__hint svg { position: absolute; right: -0.6rem; top: 1.1rem; width: 2.2rem; overflow: visible; }
  .fx-cork__hint path { fill: none; stroke: var(--accent); stroke-width: 2.2; stroke-linecap: round; stroke-linejoin: round; }
  .fx-cork__hint-touch { display: none; }
  @media (hover: none), (pointer: coarse) {
    .fx-cork__hint-fine { display: none; }
    .fx-cork__hint-touch { display: inline; }
  }
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .fx-cork__hint { display: block; opacity: 0; translate: -0.5rem 0; transition: opacity 400ms ease, translate 600ms var(--ease-spring, ease-out); }
    :global(.js) .fx-cork.is-settled .fx-cork__hint { opacity: 1; translate: 0 0; }
  }
  @media (max-width: 640px) {
    .fx-cork__hint { font-size: 1.15rem; top: 0.6rem; right: 0.25rem; }
    .fx-cork__hint svg { width: 1.7rem; top: 0.9rem; right: -0.3rem; }
  }
  @media (max-width: 380px) {
    .fx-cork__hint { top: 2.9rem; }
  }
</style>
