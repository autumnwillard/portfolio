---
// Overdrive (case studies): marker ink that bleeds. When a coral problem → cause → fix →
// result arrow (and the headline's underline) finishes drawing itself, the ink soaks into
// the paper behind it: a soft, fibrous coral halo spreads out from the stroke, trailing the
// pen, and pools where the marker started and stopped. The filter roughens the halo's edge
// like ink wicking along paper fibres. Decorative only; under reduced motion the halo is
// simply there, with no spread.
---
<svg class="fx-bleed-defs" width="0" height="0" aria-hidden="true" focusable="false">
  <filter id="fx-bleed" x="-40%" y="-40%" width="180%" height="180%" color-interpolation-filters="sRGB">
    <feTurbulence type="fractalNoise" baseFrequency="0.55" numOctaves="2" seed="11" result="fibres" />
    <feDisplacementMap in="SourceGraphic" in2="fibres" scale="7" xChannelSelector="R" yChannelSelector="G" result="wicked" />
    <feGaussianBlur in="wicked" stdDeviation="0.9" />
  </filter>
</svg>

<script>
  import '../../scripts/fx-work-inkbleed.ts';
</script>

<style>
  .fx-bleed-defs { position: absolute; width: 0; height: 0; overflow: hidden; pointer-events: none; }
  :global(.fx-bleed) { pointer-events: none; }
  :global(.fx-bleed path) { fill: none; stroke: var(--accent); stroke-linecap: round; stroke-linejoin: round; }
  :global(.fx-bleed circle) { fill: var(--accent); transform-box: fill-box; transform-origin: center; }
</style>
