---
// A key number: hand-lettered in the marker color with an ink swoosh under it.
// When it scrolls into view the number is pressed onto the page, then the marker
// swoosh is drawn under it (the shared `.draw` observer in site.ts). The text is always
// the real value; nothing counts or morphs. No JS or reduced motion: simply shown.
// `order` staggers a row of metrics so they get written one after another.
import { swoosh } from '../lib/ink';
interface Props { value: string; label: string; seed?: number; size?: 'md' | 'lg'; order?: number }
const { value, label, seed = 2, size = 'md', order = 0 } = Astro.props;
const d = swoosh(4, 10, 152, seed, 3.2);
---
<div class:list={['metric', `metric--${size}`, 'draw']} style={`--mo:${order}`}>
  <span class="metric__value">{value}</span>
  <svg class="metric__swoosh" viewBox="0 0 160 18" preserveAspectRatio="none" aria-hidden="true" focusable="false">
    <path class="ink ink--accent" d={d} pathLength="1" />
  </svg>
  <span class="metric__label">{label}</span>
  <slot />
</div>

<style>
  .metric { display: flex; flex-direction: column; align-items: flex-start; gap: 0.1rem; }
  .metric__value {
    font-family: var(--font-hand);
    font-size: var(--step-num);
    line-height: 1;
    color: var(--accent-ink);
  }
  .metric--md .metric__value { font-size: clamp(2.1rem, 1.7rem + 1.6vw, 2.9rem); }
  .metric__swoosh { width: min(9rem, 100%); height: 14px; margin: 0.1rem 0 0.35rem; overflow: visible; }
  .metric__swoosh .ink { stroke-width: 3.2; }
  .metric__label { font-weight: 700; line-height: 1.35; max-width: 24ch; }

  /* ---------- written in ----------
     The number lands with a little pen pressure (a hair big, tipped, then settles), and
     the swoosh draws left to right just after it. Each metric in a row goes ~260ms
     after the one before. */
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .metric:not(.is-drawn) .metric__value { opacity: 0; transform: translateY(0.12em) rotate(-3deg) scale(1.08); }
    :global(.js) .metric .metric__value {
      transform-origin: 0 80%;
      transition:
        opacity 260ms ease-out calc(var(--mo) * 260ms),
        transform 520ms var(--ease-spring, ease-out) calc(var(--mo) * 260ms);
    }
    :global(.js) .metric .metric__swoosh .ink {
      transition-duration: 640ms;
      transition-delay: calc(var(--mo) * 260ms + 220ms);
    }
  }
</style>
