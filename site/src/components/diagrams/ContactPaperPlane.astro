---
// contact-paper-plane: a folded paper plane with a dashed loop-de-loop trail. Decorative.
import InkSvg from '../InkSvg.astro';
import { arrow } from '../../lib/ink';
const trail = arrow([[20, 150], [70, 120], [60, 70], [110, 60], [130, 110], [100, 120], [150, 50], [210, 40]], 701, 0);
---
<InkSvg viewBox="0 0 300 170" class="contact-plane">
  <path class="ink ink--faint ink--dash" d={trail.shaft} />
  <path class="ink" style="--i:2" d="M212 40 L292 12 L246 78 L236 56 Z M236 56 L292 12" pathLength="1" />
  <path class="ink" style="--i:3" d="M236 56 L232 72 L246 64" pathLength="1" />
</InkSvg>
