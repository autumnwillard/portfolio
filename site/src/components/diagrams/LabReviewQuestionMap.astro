---
// lab-review-system-question-map: where questions go, before vs. after the
// self-serve help. Wide (side by side) and narrow (stacked) drawings.
import InkSvg from '../InkSvg.astro';
import { rect, line, arrow } from '../../lib/ink';

const label =
  'Before: every question went to the team’s helpdesk. After: questions branch to a homepage, an FAQ and walkthrough videos, and the number of questions dropped by approximately 50 percent.';

const A = (pts: [number, number][], s: number, h = 9) => { const a = arrow(pts, s, h); return `${a.shaft} ${a.head}`; };
const qs = (x: number, y: number) => [
  [x, y], [x + 46, y + 22], [x + 10, y + 62], [x + 58, y + 88], [x + 4, y + 124], [x + 50, y + 152], [x + 16, y + 192], [x + 62, y + 214],
];
const rot = [-12, 8, -4, 14, -9, 5, 11, -6];
---
<div class="lrs-qmap">
  <InkSvg viewBox="0 0 1000 420" label={label} class="only-wide">
    <!-- Before -->
    <text class="ink-text ink-fade" style="--i:0" x="20" y="38" font-size="28">Before</text>
    {qs(36, 92).map(([x, y], i) => (
      <text class="ink-text ink-fade" style={`--i:${0.5 + i * 0.15}`} x={x} y={y} font-size="34" transform={`rotate(${rot[i]} ${x} ${y})`}>?</text>
    ))}
    {[[130, 96], [140, 168], [146, 236], [132, 300]].map(([x, y], i) => (
      <path class="ink" style={`--i:${2 + i * 0.3}`} d={A([[x, y], [(x + 228) / 2, (y + 215) / 2 + (i - 1.5) * 6], [228, 205 + i * 8]], 611 + i)} pathLength="1" />
    ))}
    <path class="ink ink--bold" style="--i:3.5" d={rect(234, 158, 186, 106, 615)} pathLength="1" />
    <text class="ink-text ink-fade" style="--i:3.5" x="327" y="203" font-size="23" text-anchor="middle">Our team’s inbox</text>
    <text class="ink-text ink-fade" style="--i:3.5" x="327" y="233" font-size="23" text-anchor="middle">/ helpdesk</text>

    <path class="ink ink--faint" style="--i:4" d={line(458, 20, 456, 400, 616, 1.6)} pathLength="1" />

    <!-- After -->
    <text class="ink-text ink-fade" style="--i:5" x="482" y="38" font-size="28">After</text>
    <text class="ink-sans ink-fade fill-soft" style="--i:5" x="990" y="34" font-size="13" font-style="italic" text-anchor="end">built with a co-worker</text>
    {qs(494, 92).map(([x, y], i) => (
      <text class="ink-text ink-fade" style={`--i:${5.5 + i * 0.15}`} x={x} y={y} font-size="34" transform={`rotate(${rot[i]} ${x} ${y})`}>?</text>
    ))}
    {[
      { y: 64, h: 54, t: ['Homepage quick links'] },
      { y: 132, h: 54, t: ['FAQ with a table of contents'] },
      { y: 200, h: 72, t: ['Walkthrough video', '(one per system)'] },
    ].map((b, i) => (
      <g>
        <path class="ink" style={`--i:${7 + i * 0.4}`} d={A([[580, 150 + i * 40], [624, b.y + b.h / 2 + 10], [672, b.y + b.h / 2]], 620 + i)} pathLength="1" />
        <path class="ink" style={`--i:${7.5 + i * 0.4}`} d={rect(680, b.y, 300, b.h, 625 + i, 1.4)} pathLength="1" />
        {b.t.map((t, k) => (
          <text class="ink-text ink-fade" style={`--i:${7.5 + i * 0.4}`} x="830" y={b.y + (b.t.length === 1 ? 35 : 30 + k * 26)} font-size="22" text-anchor="middle">{t}</text>
        ))}
      </g>
    ))}
    <path class="ink ink--faint" style="--i:9" d={A([[582, 268], [626, 306], [672, 312]], 629, 8)} pathLength="1" />
    <path class="ink ink--faint" style="--i:9" d={rect(680, 290, 140, 44, 630, 1.2)} pathLength="1" />
    <text class="ink-text ink-text--soft ink-fade" style="--i:9" x="750" y="319" font-size="20" text-anchor="middle">helpdesk</text>

    <g class="on-paper" transform="rotate(3 920 330)">
      <rect class="ink-fade fill-sticky-yellow" style="--i:10" x="852" y="290" width="138" height="84" />
      <text class="ink-sans ink-fade" style="--i:10" x="864" y="314" font-size="13" font-weight="700">videos adopted by</text>
      <text class="ink-sans ink-fade" style="--i:10" x="864" y="334" font-size="13" font-weight="700">multiple research</text>
      <text class="ink-sans ink-fade" style="--i:10" x="864" y="354" font-size="13" font-weight="700">departments</text>
    </g>

    <text class="ink-text ink-text--accent ink-fade" style="--i:11" x="482" y="400" font-size="28">Questions: down approximately 50%</text>
  </InkSvg>

  <InkSvg viewBox="0 0 380 680" label={label} class="only-narrow">
    <!-- Before -->
    <text class="ink-text ink-fade" style="--i:0" x="12" y="32" font-size="26">Before</text>
    {qs(18, 70).slice(0, 6).map(([x, y], i) => (
      <text class="ink-text ink-fade" style={`--i:${0.5 + i * 0.15}`} x={x} y={y} font-size="30" transform={`rotate(${rot[i]} ${x} ${y})`}>?</text>
    ))}
    {[[96, 84], [104, 140], [96, 196]].map(([x, y], i) => (
      <path class="ink" style={`--i:${2 + i * 0.3}`} d={A([[x, y], [(x + 170) / 2, (y + 140) / 2], [168, 132 + i * 8]], 641 + i)} pathLength="1" />
    ))}
    <path class="ink ink--bold" style="--i:3.5" d={rect(176, 88, 190, 96, 645)} pathLength="1" />
    <text class="ink-text ink-fade" style="--i:3.5" x="271" y="130" font-size="22" text-anchor="middle">Our team’s inbox</text>
    <text class="ink-text ink-fade" style="--i:3.5" x="271" y="158" font-size="22" text-anchor="middle">/ helpdesk</text>

    <path class="ink ink--faint" style="--i:4" d={line(12, 240, 368, 238, 646, 1.4)} pathLength="1" />

    <!-- After -->
    <text class="ink-text ink-fade" style="--i:5" x="12" y="282" font-size="26">After</text>
    <text class="ink-sans ink-fade fill-soft" style="--i:5" x="368" y="278" font-size="12.5" font-style="italic" text-anchor="end">built with a co-worker</text>
    {qs(18, 330).slice(0, 6).map(([x, y], i) => (
      <text class="ink-text ink-fade" style={`--i:${5.5 + i * 0.15}`} x={x} y={y} font-size="30" transform={`rotate(${rot[i]} ${x} ${y})`}>?</text>
    ))}
    {[
      { y: 300, h: 48, t: ['Homepage quick links'] },
      { y: 360, h: 62, t: ['FAQ with a', 'table of contents'] },
      { y: 434, h: 62, t: ['Walkthrough video', '(one per system)'] },
    ].map((b, i) => (
      <g>
        <path class="ink" style={`--i:${7 + i * 0.4}`} d={A([[96, 360 + i * 36], [116, b.y + b.h / 2 + 6], [134, b.y + b.h / 2]], 650 + i, 8)} pathLength="1" />
        <path class="ink" style={`--i:${7.5 + i * 0.4}`} d={rect(140, b.y, 228, b.h, 655 + i, 1.3)} pathLength="1" />
        {b.t.map((t, k) => (
          <text class="ink-text ink-fade" style={`--i:${7.5 + i * 0.4}`} x="254" y={b.y + (b.t.length === 1 ? 31 : 27 + k * 24)} font-size="21" text-anchor="middle">{t}</text>
        ))}
      </g>
    ))}
    <path class="ink ink--faint" style="--i:9" d={A([[92, 486], [112, 520], [134, 528]], 659, 8)} pathLength="1" />
    <path class="ink ink--faint" style="--i:9" d={rect(140, 508, 130, 40, 660, 1.1)} pathLength="1" />
    <text class="ink-text ink-text--soft ink-fade" style="--i:9" x="205" y="535" font-size="19" text-anchor="middle">helpdesk</text>

    <text class="ink-text ink-text--accent ink-fade" style="--i:11" x="12" y="604" font-size="26">Questions: down</text>
    <text class="ink-text ink-text--accent ink-fade" style="--i:11" x="12" y="634" font-size="26">approximately 50%</text>
    <g class="on-paper" transform="rotate(3 300 610)">
      <rect class="ink-fade fill-sticky-yellow" style="--i:10" x="226" y="570" width="144" height="80" />
      <text class="ink-sans ink-fade" style="--i:10" x="236" y="594" font-size="12.5" font-weight="700">videos adopted by</text>
      <text class="ink-sans ink-fade" style="--i:10" x="236" y="613" font-size="12.5" font-weight="700">multiple research</text>
      <text class="ink-sans ink-fade" style="--i:10" x="236" y="632" font-size="12.5" font-weight="700">departments</text>
    </g>
  </InkSvg>
</div>

<style>
  .lrs-qmap { max-width: 1000px; }
  .lrs-qmap :global(.only-narrow) { max-width: 440px; }
</style>
