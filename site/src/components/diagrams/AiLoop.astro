---
// how-i-work-ai-loop: five rules as a cycle. The numbered list stays in HTML.
import InkSvg from '../InkSvg.astro';
import { arrow } from '../../lib/ink';

const label =
  'A loop of five rules: do it by hand first, keep a human in the loop, use the existing source of truth, verify before trusting, keep improving.';
const stops = [
  ['Do it by hand'],
  ['Human decides'],
  ['Use the existing', 'source of truth'],
  ['Check against', 'what a person did'],
  ['Keep improving'],
];
const C = [270, 250], R = 170;
const ang = (i: number) => (-90 + i * 72) * (Math.PI / 180);
const pt = (a: number, r = R): [number, number] => [C[0] + Math.cos(a) * r, C[1] + Math.sin(a) * r];
const arcs = stops.map((_, i) => {
  const a0 = ang(i) + 0.42, a1 = ang(i + 1) - 0.42;
  const pts = [0, 0.33, 0.66, 1].map((t) => pt(a0 + (a1 - a0) * t, R - 2 + Math.sin(t * Math.PI) * 6));
  return arrow(pts, 70 + i, 11);
});
const back = [C[0], C[1] + 6];
// label anchor: pushed outward from the circle a bit
const labelPos = (i: number) => {
  const [x, y] = pt(ang(i), R + 4);
  return [x, y];
};
---
<InkSvg viewBox="0 20 540 470" label={label} class="ai-loop">
  {arcs.map((a, i) => (
    <path class:list={['ink', i === 4 ? 'ink--accent ink--bold' : '']} style={`--i:${i * 1.2 + 1}`} d={a.shaft + ' ' + a.head} pathLength="1" />
  ))}
  {stops.map((lines, i) => {
    const [x, y] = labelPos(i);
    const off = (lines.length - 1) * 12;
    return (
      <g>
        <circle class="ink-fade fill-paper stroke-ink" style={`--i:${i * 1.2}`} cx={x} cy={y - off - 32} r="15" stroke-width="2" />
        <text class="ink-text ink-text--accent ink-fade" style={`--i:${i * 1.2}`} x={x} y={y - off - 24} font-size="21" text-anchor="middle">{i + 1}</text>
        {lines.map((l, k) => (
          <text class="ink-text ink-fade" style={`--i:${i * 1.2}`} x={x} y={y - off + 6 + k * 27} font-size="26" text-anchor="middle">{l}</text>
        ))}
      </g>
    );
  })}
  <text class="ink-text ink-text--accent ink-fade" style="--i:7" x={back[0]} y={back[1]} font-size="24" text-anchor="middle">back to the start</text>
</InkSvg>

<style>
  :global(svg.ink-svg.ai-loop) { max-width: 30rem; }
</style>
