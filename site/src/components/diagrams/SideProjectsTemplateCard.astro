---
// this-site-template-card: an index card with the case-study outline on it, clipped on
// with a paperclip. The content model, shown as a product decision.
import InkSvg from '../InkSvg.astro';
import { line, rect, smooth } from '../../lib/ink';

const items = ['the problem', 'digging in', 'constraints', 'decisions', 'outcome', 'lessons'];
const W = 300, H = 268, X = 14, Y = 22, HEAD = 58, PITCH = 32;
const clip = smooth([[262, 4], [262, 66], [274, 78], [286, 66], [286, 14], [278, 4], [270, 14], [270, 56]]);
---
<InkSvg viewBox="0 0 330 300" label="Every case study follows the same outline: problem, digging in, constraints, decisions, outcome, lessons." class="sp-card">
  <g transform="rotate(-1.5 165 150)">
    <rect x={X} y={Y} width={W} height={H} class="sp-card__paper" />
    <path class="sp-card__head" d={`M${X} ${Y + HEAD} H${X + W}`} />
    {items.map((_, i) => <path class="sp-card__line" d={`M${X} ${Y + HEAD + PITCH * (i + 1)} H${X + W}`} />)}
    <path class="ink ink--faint" style="--i:0" d={rect(X, Y, W, H, 1101, 0.6)} pathLength="1" />
    <text class="ink-text ink-fade" x={X + 16} y={Y + 42} font-size="27">Every case study:</text>
    {items.map((t, i) => (
      <>
        <text class="ink-text ink-text--accent ink-fade" style={`--i:${0.6 + i * 0.3}`} x={X + 18} y={Y + HEAD + PITCH * (i + 1) - 7} font-size="21">{i + 1}.</text>
        <text class="ink-text ink-fade" style={`--i:${0.6 + i * 0.3}`} x={X + 44} y={Y + HEAD + PITCH * (i + 1) - 7} font-size="23">{t}</text>
      </>
    ))}
    <path class="ink ink--accent" style="--i:3" d={line(X + 150, Y + HEAD + PITCH * 4 - 4, X + 260, Y + HEAD + PITCH * 4 - 6, 1110, 0.8)} pathLength="1" />
  </g>
  <path class="ink ink--bold sp-card__clip" style="--i:3.6" d={clip} pathLength="1" />
</InkSvg>

<style>
  :global(svg.ink-svg.sp-card) { max-width: 19rem; }
  :global(.sp-card .sp-card__paper) { fill: var(--card); filter: drop-shadow(0 4px 6px rgb(60 50 40 / 0.16)); }
  :global(.sp-card .sp-card__head) { stroke: rgb(224 74 50 / 0.55); stroke-width: 2; }
  :global(.sp-card .sp-card__line) { stroke: rgb(84 130 176 / 0.25); stroke-width: 1.2; }
  :global(.sp-card .sp-card__clip) { stroke: #7d776f; }
</style>
