---
// tech-handoff-five-vs-one: the math. Five small clients at $400 ≈ one mid-size
// client at $1,500–$2,000, but every client needs the same work (brand talk ·
// iterate · outline · build). "Five times over" is words on a doodle, not a rate.
import InkSvg from '../InkSvg.astro';
import { rect, line } from '../../lib/ink';

const label =
  'Five small clients at $400 each bring in about what one mid-size client pays at $1,500 to $2,000. Each small client still needs the same brand discussion, iteration, outlining and build, so the five take far more work and carry more risk of not getting paid.';

/** A small house: body + roof + door, centered on cx, ground at gy. */
const house = (cx: number, gy: number, w: number, s: number) => {
  const h = w * 0.85;
  const top = gy - h;
  return [
    rect(cx - w / 2, top, w, h, s, 0.9),
    line(cx - w / 2 - 6, top + 2, cx, top - w * 0.55, s + 5, 0.7),
    line(cx, top - w * 0.55, cx + w / 2 + 6, top + 2, s + 6, 0.7),
    line(cx - w * 0.1, gy, cx - w * 0.1, gy - h * 0.45, s + 7, 0.4),
    line(cx - w * 0.1, gy - h * 0.45, cx + w * 0.12, gy - h * 0.45, s + 8, 0.4),
    line(cx + w * 0.12, gy - h * 0.45, cx + w * 0.12, gy, s + 9, 0.4),
  ].join(' ');
};

/** Four tiny ticked boxes: the same checklist for every client. */
const checks = (cx: number, y: number, s: number, size = 10, gap = 16) => {
  const x0 = cx - (gap * 3 + size) / 2;
  return [0, 1, 2, 3].map((k) => {
    const x = x0 + k * gap;
    return `${rect(x, y, size, size, s + k * 3, 0.4)} M${x + 2} ${y + 5} L${x + 4.5} ${y + 8} L${x + size + 1} ${y - 1}`;
  }).join(' ');
};

const building = (x: number, y: number, w: number, h: number, s: number) => {
  const wins: string[] = [];
  for (let r = 0; r < 4; r++) for (let c = 0; c < 3; c++) {
    wins.push(rect(x + 18 + c * ((w - 36) / 3) + 4, y + 18 + r * 30, (w - 36) / 3 - 10, 16, s + 20 + r * 3 + c, 0.4));
  }
  return { body: rect(x, y, w, h, s, 1.1), wins: wins.join(' '), door: rect(x + w / 2 - 14, y + h - 34, 28, 34, s + 9, 0.5) };
};

const wideX = [70, 165, 260, 355, 450];
const narrowX = [40, 112, 184, 256, 328];
const worries: Record<number, string[]> = { 1: ['late?'], 3: ['unpaid', 'hosting?'] };
const bw = building(686, 66, 150, 166, 1101);
const bn = building(118, 446, 144, 160, 1151);
---
<div class="th-five">
  <InkSvg viewBox="0 0 920 390" label={label} class="only-wide">
    {wideX.map((cx, i) => (
      <g>
        <path class="ink" style={`--i:${i * 0.5}`} d={house(cx, 218, 66, 1010 + i * 20)} pathLength="1" />
        <text class="ink-text ink-text--accent ink-fade" style={`--i:${i * 0.5 + 1}`} x={cx} y="248" font-size="24" text-anchor="middle">$400</text>
        <path class="ink ink--faint" style={`--i:${i * 0.5 + 1}`} d={checks(cx, 262, 1080 + i * 10)} pathLength="1" />
        {(worries[i] ?? []).map((t, k, all) => (
          <text class="ink-text ink-text--soft ink-fade" style={`--i:${i * 0.5 + 2}`} x={cx + 30} y={112 - (all.length - 1 - k) * 18} font-size="18">{t}</text>
        ))}
      </g>
    ))}
    <text class="ink-sans ink-fade fill-soft" style="--i:4" x="260" y="306" font-size="14.5" text-anchor="middle">each: brand talk · iterate · outline · build</text>
    <text class="ink-text ink-text--accent ink-fade" style="--i:4.5" x="260" y="344" font-size="27" text-anchor="middle">same work, five times over</text>

    <text class="ink-text ink-fade" style="--i:5" x="604" y="200" font-size="72" text-anchor="middle">≈</text>

    <path class="ink" style="--i:6" d={bw.body} pathLength="1" />
    <path class="ink ink--faint" style="--i:6.5" d={bw.wins} pathLength="1" />
    <path class="ink" style="--i:6.5" d={bw.door} pathLength="1" />
    <text class="ink-text ink-text--accent ink-fade" style="--i:7" x="761" y="262" font-size="25" text-anchor="middle">$1,500–$2,000</text>
    <path class="ink ink--faint" style="--i:7" d={checks(761, 276, 1180)} pathLength="1" />
    <text class="ink-sans ink-fade fill-soft" style="--i:7.5" x="761" y="318" font-size="14.5" text-anchor="middle">brand talk · iterate</text>
    <text class="ink-sans ink-fade fill-soft" style="--i:7.5" x="761" y="338" font-size="14.5" text-anchor="middle">outline · build</text>
  </InkSvg>

  <InkSvg viewBox="0 0 380 720" label={label} class="only-narrow">
    {narrowX.map((cx, i) => (
      <g>
        <path class="ink" style={`--i:${i * 0.5}`} d={house(cx, 168, 50, 1210 + i * 20)} pathLength="1" />
        <text class="ink-text ink-text--accent ink-fade" style={`--i:${i * 0.5 + 1}`} x={cx} y="196" font-size="21" text-anchor="middle">$400</text>
        <path class="ink ink--faint" style={`--i:${i * 0.5 + 1}`} d={checks(cx, 208, 1280 + i * 10, 8, 13)} pathLength="1" />
        {(worries[i] ?? []).map((t, k, all) => (
          <text class="ink-text ink-text--soft ink-fade" style={`--i:${i * 0.5 + 2}`} x={cx} y={60 - (all.length - 1 - k) * 17} font-size="16" text-anchor="middle">{t}</text>
        ))}
      </g>
    ))}
    <text class="ink-sans ink-fade fill-soft" style="--i:4" x="190" y="252" font-size="13.5" text-anchor="middle">each: brand talk · iterate · outline · build</text>
    <text class="ink-text ink-text--accent ink-fade" style="--i:4.5" x="190" y="290" font-size="25" text-anchor="middle">same work, five times over</text>

    <text class="ink-text ink-fade" style="--i:5" x="190" y="392" font-size="68" text-anchor="middle">≈</text>

    <path class="ink" style="--i:6" d={bn.body} pathLength="1" />
    <path class="ink ink--faint" style="--i:6.5" d={bn.wins} pathLength="1" />
    <path class="ink" style="--i:6.5" d={bn.door} pathLength="1" />
    <text class="ink-text ink-text--accent ink-fade" style="--i:7" x="190" y="642" font-size="25" text-anchor="middle">$1,500–$2,000</text>
    <path class="ink ink--faint" style="--i:7" d={checks(190, 656, 1380)} pathLength="1" />
    <text class="ink-sans ink-fade fill-soft" style="--i:7.5" x="190" y="700" font-size="13.5" text-anchor="middle">brand talk · iterate · outline · build</text>
  </InkSvg>
</div>

<style>
  .th-five { max-width: 920px; }
  .th-five :global(.only-narrow) { max-width: 420px; }
</style>
