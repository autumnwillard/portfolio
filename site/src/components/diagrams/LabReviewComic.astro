---
// lab-review-system-never-submitted-comic: three-panel comic strip.
// 1: a record with empty fields, no submit button, status "New"; "Done!"
// 2: weeks later, "What do you mean it was never submitted?"
// 3: the fix: grayed-out button, "Unsubmitted Draft", a leave-page warning.
// Side by side on wide screens, stacked on narrow ones. Placeholder text only.
import InkSvg from '../InkSvg.astro';
import { rect, line, loop } from '../../lib/ink';

const label =
  "Before: a record showed the status ‘New’ with no visible submit button, so researchers thought they were done. After: the ‘Start Manager Review’ button is visible but grayed out, the status reads ‘Unsubmitted Draft,’ and leaving the page triggers a warning.";

const PW = 320, PH = 330;
const layouts = [
  { cls: 'only-wide', vb: '0 0 1010 340', pos: [[5, 5], [345, 5], [685, 5]] as [number, number][] },
  { cls: 'only-narrow', vb: '0 0 330 1050', pos: [[5, 5], [5, 360], [5, 715]] as [number, number][] },
];

/** A stick figure, feet at (x, y). */
const person = (x: number, y: number, s: number, arms: 'up' | 'down' = 'down') => {
  const head = loop(x, y - 92, 13, 14, s, 1.05);
  const body = line(x, y - 77, x + 1, y - 34, s + 1, 0.8);
  const legs = `${line(x + 1, y - 34, x - 13, y, s + 2, 0.8)} ${line(x + 1, y - 34, x + 14, y, s + 3, 0.8)}`;
  const armPath = arms === 'up'
    ? `${line(x, y - 66, x - 20, y - 90, s + 4, 0.8)} ${line(x, y - 66, x + 20, y - 90, s + 5, 0.8)}`
    : `${line(x, y - 66, x - 18, y - 46, s + 4, 0.8)} ${line(x, y - 66, x + 18, y - 46, s + 5, 0.8)}`;
  return `${head} ${body} ${legs} ${armPath}`;
};

/** Speech bubble: a box with a little tail pointing at (tx, ty). */
const bubble = (x: number, y: number, w: number, h: number, tx: number, ty: number, s: number) =>
  `${rect(x, y, w, h, s, 1.2)} ${line(tx - 8, y + h, tx, ty, s + 7, 0.6)} ${line(tx, ty, tx + 8, y + h, s + 8, 0.6)}`;

/** Empty required field with a label line. */
const field = (x: number, y: number, w: number, s: number) =>
  `${line(x, y, x + 46, y, s, 0.6)} ${rect(x, y + 8, w, 20, s + 1, 0.9)}`;
---
<div class="lrs-comic">
  {layouts.map((L, li) => {
    const [p1, p2, p3] = L.pos;
    const sd = li * 100;
    return (
      <InkSvg viewBox={L.vb} label={label} class={L.cls}>
        {/* ---------- Panel 1: before ---------- */}
        <g transform={`translate(${p1[0]} ${p1[1]})`}>
          <path class="ink ink--bold" style="--i:0" d={rect(0, 0, PW, PH, 510 + sd, 1.4)} pathLength="1" />
          <text class="ink-text ink-fade" style="--i:0" x="16" y="34" font-size="24">Before</text>
          <path class="ink" style="--i:1" d={rect(16, 56, 190, 250, 511 + sd, 1.2)} pathLength="1" />
          <text class="ink-sans ink-fade" style="--i:1" x="30" y="84" font-size="13" font-weight="700" fill="#57524c">Status</text>
          <path class="ink" style="--i:2" d={rect(82, 66, 64, 26, 512 + sd, 0.9)} pathLength="1" />
          <text class="ink-text ink-fade" style="--i:2" x="114" y="86" font-size="20" text-anchor="middle">New</text>
          {[118, 168, 218].map((y, k) => (
            <>
              <path class="ink ink--faint" style={`--i:${2 + k * 0.3}`} d={field(30, y, 160, 520 + k * 3 + sd)} pathLength="1" />
              <text class="ink-text ink-text--accent ink-fade" style={`--i:${2 + k * 0.3}`} x="82" y={y + 6} font-size="18">*</text>
            </>
          ))}
          <text class="ink-sans ink-fade" style="--i:3" x="111" y="290" font-size="12.5" font-style="italic" text-anchor="middle" fill="#57524c">(no button anywhere)</text>
          <path class="ink" style="--i:4" d={person(262, 300, 530 + sd, 'up')} pathLength="1" />
          <path class="ink" style="--i:5" d={bubble(218, 120, 90, 44, 252, 182, 540 + sd)} pathLength="1" />
          <text class="ink-text ink-fade" style="--i:5" x="263" y="150" font-size="24" text-anchor="middle">Done!</text>
        </g>

        {/* ---------- Panel 2: weeks later ---------- */}
        <g transform={`translate(${p2[0]} ${p2[1]})`}>
          <path class="ink ink--bold" style="--i:6" d={rect(0, 0, PW, PH, 550 + sd, 1.4)} pathLength="1" />
          <text class="ink-text ink-fade" style="--i:6" x="16" y="34" font-size="24">Weeks later…</text>
          <path class="ink" style="--i:7" d={bubble(40, 52, 266, 98, 92, 186, 551 + sd)} pathLength="1" />
          <text class="ink-text ink-fade" style="--i:7" x="173" y="86" font-size="23" text-anchor="middle">“What do you mean</text>
          <text class="ink-text ink-fade" style="--i:7" x="173" y="114" font-size="23" text-anchor="middle">it was never</text>
          <text class="ink-text ink-text--accent ink-fade" style="--i:7" x="173" y="140" font-size="23" text-anchor="middle">submitted?”</text>
          <path class="ink" style="--i:8" d={person(84, 300, 560 + sd, 'up')} pathLength="1" />
          {/* the forgotten record, gathering dust */}
          <g transform="translate(212 214) rotate(4)">
            <path class="ink ink--faint" style="--i:9" d={rect(0, 0, 86, 98, 570 + sd, 1)} pathLength="1" />
            <path class="ink ink--faint" style="--i:9" d={`${line(10, 30, 70, 30, 571 + sd, 0.5)} ${line(10, 50, 62, 50, 572 + sd, 0.5)} ${line(10, 70, 70, 70, 573 + sd, 0.5)}`} pathLength="1" />
            <text class="ink-text ink-text--soft ink-fade" style="--i:9" x="43" y="21" font-size="16" text-anchor="middle">New</text>
          </g>
          <path class="ink ink--faint" style="--i:9" d={`${line(204, 196, 214, 186, 574 + sd, 0.4)} ${line(262, 190, 276, 182, 575 + sd, 0.4)} ${line(300, 212, 312, 204, 576 + sd, 0.4)}`} pathLength="1" />
        </g>

        {/* ---------- Panel 3: after ---------- */}
        <g transform={`translate(${p3[0]} ${p3[1]})`}>
          <path class="ink ink--bold" style="--i:10" d={rect(0, 0, PW, PH, 580 + sd, 1.4)} pathLength="1" />
          <text class="ink-text ink-text--accent ink-fade" style="--i:10" x="16" y="34" font-size="24">After</text>
          <path class="ink" style="--i:11" d={rect(16, 56, 236, 236, 581 + sd, 1.2)} pathLength="1" />
          <text class="ink-sans ink-fade" style="--i:11" x="30" y="84" font-size="13" font-weight="700" fill="#57524c">Status</text>
          <rect class="ink-fade" style="--i:12" x="80" y="66" width="160" height="28" rx="6" fill="#fbe55c" fill-opacity="0.9" transform="rotate(-1.5 160 80)" />
          <text class="ink-text ink-fade" style="--i:12" x="160" y="87" font-size="21" text-anchor="middle">Unsubmitted Draft</text>
          {[118, 168].map((y, k) => (
            <path class="ink ink--faint" style={`--i:${12 + k * 0.3}`} d={field(30, y, 160, 590 + k * 3 + sd)} pathLength="1" />
          ))}
          <rect class="ink-fade" style="--i:13" x="30" y="234" width="180" height="40" rx="9" fill="#ece9e2" stroke="#a49d93" stroke-width="2" stroke-dasharray="5 5" />
          <text class="ink-sans ink-fade" style="--i:13" x="120" y="259" font-size="13.5" font-weight="700" text-anchor="middle" fill="#6b655e">Start Manager Review</text>
          {/* leave-page warning */}
          <g transform="translate(138 150) rotate(2)">
            <rect class="ink-fade" style="--i:14" x="0" y="0" width="172" height="78" rx="4" fill="#ffffff" />
            <path class="ink" style="--i:14" d={rect(0, 0, 172, 78, 600 + sd, 1)} pathLength="1" />
            <text class="ink-text ink-fade" style="--i:14" x="14" y="30" font-size="21">Leave page?</text>
            <text class="ink-sans ink-fade" style="--i:14" x="14" y="56" font-size="12.5">Changes may not save.</text>
          </g>
          <text class="ink-text ink-text--accent ink-fade" style="--i:15" x="120" y="318" font-size="18" text-anchor="middle">visible, grayed out</text>
        </g>
      </InkSvg>
    );
  })}
</div>

<style>
  .lrs-comic { max-width: 1010px; }
  .lrs-comic :global(.only-narrow) { max-width: 420px; }
</style>
