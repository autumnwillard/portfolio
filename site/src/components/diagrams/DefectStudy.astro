---
// release-risk-review-defect-study: data in, ranked fixes out.
// A ranked list, not a Pareto chart: per-fix shares aren't sourced.
import InkSvg from '../InkSvg.astro';
import { rect, line, loop } from '../../lib/ink';

const label =
  'Defect study of about 200 defects across about 2,100 code changes produced 8 ranked preventive fixes. The top 4 address about 70% of the defects studied.';
const fixes = Array.from({ length: 8 }, (_, i) => `Fix ${i + 1}`);

const bracket = (x: number, t: number, b: number) => {
  const m = (t + b) / 2;
  return `M${x} ${t} C${x + 12} ${t} ${x + 12} ${t + 10} ${x + 12} ${t + 24} L${x + 12} ${m - 14} C${x + 12} ${m - 4} ${x + 16} ${m} ${x + 24} ${m} C${x + 16} ${m} ${x + 12} ${m + 4} ${x + 12} ${m + 14} L${x + 12} ${b - 24} C${x + 12} ${b - 10} ${x + 12} ${b} ${x} ${b}`;
};
---
<div class="defects">
  <InkSvg viewBox="0 0 680 400" label={label} class="only-wide">
    <!-- header strip -->
    <path class="ink" style="--i:0" d={rect(20, 14, 640, 50, 301, 1.4)} pathLength="1" />
    <text class="ink-text ink-fade" style="--i:0" x="40" y="48" font-size="27">~200 defects · ~2,100 code changes</text>
    <path class="ink ink--faint" style="--i:1" d={line(340, 70, 340, 92, 302, 1)} pathLength="1" />

    <!-- index card -->
    <path class="paper ink-fade" style="--i:1" d="M30 100 L196 98 L198 384 L32 386 Z" />
    <path class="ink" style="--i:1" d={rect(30, 98, 166, 288, 303, 1.3)} pathLength="1" />
    <path class="ink ink--accent" style="--i:2" d={line(34, 126, 192, 125, 304, 0.8)} pathLength="1" />
    {fixes.map((f, i) => (
      <g>
        <path class="ink ink--faint" style={`--i:${2 + i * 0.15}`} d={line(36, 160 + i * 29, 190, 160 + i * 29, 310 + i, 0.6)} pathLength="1" />
        <text class="ink-text ink-fade" style={`--i:${3 + i * 0.2}`} x="48" y={154 + i * 29} font-size="21">{f}</text>
      </g>
    ))}
    <path class="ink ink--accent ink--bold" style="--i:5" d={bracket(204, 134, 248)} pathLength="1" />
    <text class="ink-text ink-text--accent ink-fade" style="--i:6" x="246" y="186" font-size="23">top 4 →</text>
    <text class="ink-text ink-text--accent ink-fade" style="--i:6" x="246" y="212" font-size="23">~70% of defects studied</text>

    <!-- root-cause bubbles -->
    <text class="ink-sans ink-fade" style="--i:7" x="478" y="112" font-size="13.5" font-weight="800" fill="#57524c" letter-spacing="1">ROOT-CAUSE BUCKETS</text>
    <path class="ink" style="--i:7" d={loop(568, 222, 96, 92, 320, 1.04)} pathLength="1" />
    <text class="ink-sans ink-fade" style="--i:8" x="568" y="208" font-size="15.5" font-weight="700" text-anchor="middle">new functionality</text>
    <text class="ink-sans ink-fade" style="--i:8" x="568" y="229" font-size="15.5" font-weight="700" text-anchor="middle">with partner APIs</text>
    <text class="ink-sans ink-fade" style="--i:8" x="568" y="252" font-size="14" text-anchor="middle" fill="#57524c">(the majority)</text>
    <path class="ink" style="--i:9" d={loop(404, 330, 72, 50, 321, 1.04)} pathLength="1" />
    <text class="ink-sans ink-fade" style="--i:9" x="404" y="318" font-size="13.5" text-anchor="middle">unresolved /</text>
    <text class="ink-sans ink-fade" style="--i:9" x="404" y="336" font-size="13.5" text-anchor="middle">uncoordinated</text>
    <text class="ink-sans ink-fade" style="--i:9" x="404" y="354" font-size="13.5" text-anchor="middle">dependencies</text>
  </InkSvg>

  <InkSvg viewBox="0 0 380 640" label={label} class="only-narrow">
    <path class="ink" style="--i:0" d={rect(12, 12, 356, 74, 331, 1.4)} pathLength="1" />
    <text class="ink-text ink-fade" style="--i:0" x="30" y="44" font-size="25">~200 defects ·</text>
    <text class="ink-text ink-fade" style="--i:0" x="30" y="72" font-size="25">~2,100 code changes</text>

    <path class="paper ink-fade" style="--i:1" d="M18 110 L168 108 L170 390 L20 392 Z" />
    <path class="ink" style="--i:1" d={rect(18, 108, 152, 284, 333, 1.3)} pathLength="1" />
    <path class="ink ink--accent" style="--i:2" d={line(22, 134, 166, 133, 334, 0.8)} pathLength="1" />
    {fixes.map((f, i) => (
      <g>
        <path class="ink ink--faint" style={`--i:${2 + i * 0.15}`} d={line(24, 168 + i * 28, 164, 168 + i * 28, 340 + i, 0.6)} pathLength="1" />
        <text class="ink-text ink-fade" style={`--i:${3 + i * 0.2}`} x="36" y={162 + i * 28} font-size="21">{f}</text>
      </g>
    ))}
    <path class="ink ink--accent ink--bold" style="--i:5" d={bracket(176, 142, 252)} pathLength="1" />
    <text class="ink-text ink-text--accent ink-fade" style="--i:6" x="214" y="176" font-size="23">top 4 →</text>
    <text class="ink-text ink-text--accent ink-fade" style="--i:6" x="214" y="202" font-size="23">~70% of</text>
    <text class="ink-text ink-text--accent ink-fade" style="--i:6" x="214" y="228" font-size="23">defects studied</text>

    <text class="ink-sans ink-fade" style="--i:7" x="18" y="432" font-size="13.5" font-weight="800" fill="#57524c" letter-spacing="1">ROOT-CAUSE BUCKETS</text>
    <path class="ink" style="--i:7" d={loop(130, 530, 112, 84, 350, 1.04)} pathLength="1" />
    <text class="ink-sans ink-fade" style="--i:8" x="130" y="518" font-size="15.5" font-weight="700" text-anchor="middle">new functionality</text>
    <text class="ink-sans ink-fade" style="--i:8" x="130" y="539" font-size="15.5" font-weight="700" text-anchor="middle">with partner APIs</text>
    <text class="ink-sans ink-fade" style="--i:8" x="130" y="561" font-size="14" text-anchor="middle" fill="#57524c">(the majority)</text>
    <path class="ink" style="--i:9" d={loop(312, 548, 62, 52, 351, 1.04)} pathLength="1" />
    <text class="ink-sans ink-fade" style="--i:9" x="312" y="535" font-size="13" text-anchor="middle">unresolved /</text>
    <text class="ink-sans ink-fade" style="--i:9" x="312" y="553" font-size="13" text-anchor="middle">uncoordinated</text>
    <text class="ink-sans ink-fade" style="--i:9" x="312" y="571" font-size="13" text-anchor="middle">dependencies</text>
  </InkSvg>
</div>

<style>
  .defects { max-width: 760px; }
  .defects :global(.paper) { fill: #fff; }
</style>
