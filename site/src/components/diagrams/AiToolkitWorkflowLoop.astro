---
// ai-toolkit-workflow-loop: how a workflow earns trust. Five stops in a loop,
// back to the start through the backlog of fixes. "I decide" is highlighted.
import InkSvg from '../InkSvg.astro';
import { arrow } from '../../lib/ink';

const label =
  'Loop showing how each workflow is built: do the task by hand with the AI, turn the corrections into rules, let the AI draft until it has been tested, a person decides, check results against hand counts, then add fixes to the backlog and repeat.';
const stops = [
  ['Do it by hand', 'with the AI'],
  ['My corrections', 'become rules'],
  ['AI drafts', '(until it’s tested)'],
  ['I decide'],
  ['Check against', 'hand counts /', 'a no-AI baseline'],
];
const C = [280, 262], R = 172;
const ang = (i: number) => (-90 + i * 72) * (Math.PI / 180);
const pt = (a: number, r = R): [number, number] => [C[0] + Math.cos(a) * r, C[1] + Math.sin(a) * r];
const arcs = stops.map((_, i) => {
  const a0 = ang(i) + 0.44, a1 = ang(i + 1) - 0.44;
  const pts = [0, 0.33, 0.66, 1].map((t) => pt(a0 + (a1 - a0) * t, R - 2 + Math.sin(t * Math.PI) * 6));
  return arrow(pts, 90 + i, 11);
});
---
<InkSvg viewBox="0 20 560 500" label={label} class="toolkit-loop">
  {arcs.map((a, i) => (
    <path class:list={['ink', i === 4 ? 'ink--accent ink--bold' : '']} style={`--i:${i * 1.2 + 1}`} d={a.shaft + ' ' + a.head} pathLength="1" />
  ))}
  {stops.map((lines, i) => {
    const [x, y] = pt(ang(i), R + 4);
    const off = (lines.length - 1) * 12;
    return (
      <g>
        {i === 3 && (
          <rect class="ink-fade fill-hl" style={`--i:${i * 1.2}`} x={x - 62} y={y - off - 14} width="124" height="30" rx="6" fill-opacity="0.9" transform={`rotate(-2 ${x} ${y})`} />
        )}
        <circle class="ink-fade fill-paper stroke-ink" style={`--i:${i * 1.2}`} cx={x} cy={y - off - 32} r="15" stroke-width="2" />
        <text class="ink-text ink-text--accent ink-fade" style={`--i:${i * 1.2}`} x={x} y={y - off - 24} font-size="21" text-anchor="middle">{i + 1}</text>
        {lines.map((l, k) => (
          <text class="ink-text ink-fade" style={`--i:${i * 1.2}`} x={x} y={y - off + 8 + k * 26} font-size="24" text-anchor="middle">{l}</text>
        ))}
      </g>
    );
  })}
  <text class="ink-text ink-text--accent ink-fade" style="--i:7" x={C[0]} y={C[1] - 4} font-size="24" text-anchor="middle">backlog of fixes,</text>
  <text class="ink-text ink-text--accent ink-fade" style="--i:7" x={C[0]} y={C[1] + 24} font-size="24" text-anchor="middle">back to the start</text>
</InkSvg>

<style>
  :global(svg.ink-svg.toolkit-loop) { max-width: 31rem; }
</style>
