// Cloudflare Workers (static assets only): serves the Astro build in dist/.
// "name" matches the Worker in the Cloudflare dashboard (portfolio).
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "portfolio",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
